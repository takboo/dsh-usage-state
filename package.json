{
  "name": "dsh-usage-state",
  "version": "0.4.5",
  "packageManager": "npm@11.19.1",
  "type": "module",
  "description": "DSH plugin: show account balance (API mode) or coding-plan quota (5h/7d/30d) for the model in use",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --import ./tests/support/client-render-hook.mjs --test",
    "test:watch": "node --import ./tests/support/client-render-hook.mjs --test --watch",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "watch": "tsdown --watch",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "verify": "npm run verify:metadata && npm run typecheck && npm run build && npm test && npm run verify:artifacts && npm run verify:package"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-loader": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2",
    "unrun": "^0.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/adapters.md"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "usage",
    "balance",
    "quota",
    "coding-plan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takboo/dsh-usage-state.git"
  },
  "homepage": "https://github.com/takboo/dsh-usage-state#readme",
  "bugs": {
    "url": "https://github.com/takboo/dsh-usage-state/issues"
  }
}
